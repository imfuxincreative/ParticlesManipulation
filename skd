## 3. Shaders

### 3.1 `src/shaders/atmosphericFog.glsl.ts` (the key chunk)

```glsl
uniform vec3  uFogColor;        // derived, linear
uniform float uFogDensity;
uniform float uFogHeightFalloff;
uniform float uFogHeightBase;
uniform float uFogEnabled;      // 0/1
uniform vec3  uCamPos;
uniform vec3  uGlowColor;
uniform vec3  uGlowDir;
uniform float uGlowStrength;

// Shared by the sky AND fogged geometry, so silhouettes in the glow region pick up the glow too.
vec3 atmosphereInscatter(vec3 dir) {
  float g = pow(max(dot(dir, uGlowDir), 0.0), 6.0);
  return uFogColor + uGlowColor * g * uGlowStrength;
}

float atmosphereFactor(float viewDist, vec3 worldPos) {
  float distFog   = 1.0 - exp(-pow(viewDist * uFogDensity, 1.6));
  float h         = max(worldPos.y - uFogHeightBase, 0.0);
  float heightFog = exp(-h * uFogHeightFalloff);
  return clamp(distFog * mix(1.0, heightFog, 0.65), 0.0, 1.0) * uFogEnabled;
}

vec3 applyAtmosphere(vec3 color, float viewDist, vec3 worldPos) {
  float f    = atmosphereFactor(viewDist, worldPos);
  float luma = dot(color, vec3(0.299, 0.587, 0.114));
  color  = mix(color, vec3(luma), f * 0.5);   // desaturate far
  color *= mix(1.0, 0.55, f);                 // darken far (also fades shadows → shadow*(1-f))
  return mix(color, atmosphereInscatter(normalize(worldPos - uCamPos)), f);
}

// For additive particles: fade energy out instead of tinting toward the haze.
vec3 applyAtmosphereAdditive(vec3 color, float viewDist, vec3 worldPos) {
  return color * (1.0 - atmosphereFactor(viewDist, worldPos));
}
```

### 3.2 `src/shaders/skyDome.glsl.ts`

- **Vertex**: `vWorldDir = mat3(modelMatrix) * position`. The mesh follows the camera's **position only** (fixes A). `gl_Position.z = gl_Position.w` pins the dome to the far plane at any radius.
- **Fragment** (`CLOUD_OCTAVES` is a define: 5 on high quality, 3 on low):

```glsl
vec3 dir  = normalize(vWorldDir);
float t   = smoothstep(-0.05, 0.75, dir.y);
vec3 base = mix(uHorizonColor, uZenithColor, pow(t, 0.8));
base     += uGlowColor * pow(max(dot(dir, uGlowDir), 0.0), 6.0) * uGlowStrength;

vec2 p  = dir.xz / (max(dir.y, 0.0) + 0.3) * uCloudScale + uTime * uCloudSpeed * vec2(1.0, 0.35);
float n = clamp((fbm(p) - 0.5) * uCloudContrast + 0.5, 0.0, 1.0);
base   *= mix(1.0, 0.75 + 0.5 * n, smoothstep(0.0, 0.18, dir.y)); // clouds fade out at horizon (no stretching)
base   *= clamp(uSkyExposure, 0.5, 1.5);

// Seam-free horizon: at dir.y <= 0 the sky IS the fog inscatter
vec3 col = mix(atmosphereInscatter(dir), base, smoothstep(0.0, 0.12, dir.y));
gl_FragColor = vec4(col, 1.0);
#include <tonemapping_fragment>
#include <colorspace_fragment>
```

- Material settings: `side: BackSide, depthWrite: false, fog: false, toneMapped: false`, `renderOrder = -1000`.
- The value noise and fBm go in a shared `noise.glsl.ts`, which the hedge shader also uses. It's low-frequency, rotated per octave, and has no hard edges.
- The edge/bottom darkening is done in **post**, in screen space. That way it can't break the sky/ground seam.

### 3.3 Custom materials: why `fog: false`

Custom ShaderMaterials call `applyAtmosphere()` directly at the end of `main()`. They stay at `fog: false` on purpose. With `fog: true`, three.js expects `UniformsLib.fog` uniforms and runs its own fog on top, which would double-fog. Each shader gets:
- a `vWorldPos` varying (instancing-aware),
- `gl_FragColor.rgb = applyAtmosphere(rgb, distance(vWorldPos, uCamPos), vWorldPos);`
- the `<tonemapping_fragment>` and `<colorspace_fragment>` includes (fixes I).

### 3.4 Built-in materials: `src/lib/patchAtmosphere.ts`

```ts
export function patchMaterialWithAtmosphere(mat: THREE.Material): void {
  if (mat.userData.atmospherePatched === true) return;
  mat.userData.atmospherePatched = true;
  mat.onBeforeCompile = (shader) => {
    Object.assign(shader.uniforms, atmosphereUniforms);          // shared refs
    shader.vertexShader = shader.vertexShader
      .replace("#include <common>", "#include <common>\nvarying vec3 vAtmoWorldPos;")
      .replace("#include <project_vertex>", `#include <project_vertex>
        vec4 atmoWP = vec4(transformed, 1.0);
        #ifdef USE_BATCHING
          atmoWP = batchingMatrix * atmoWP;
        #endif
        #ifdef USE_INSTANCING
          atmoWP = instanceMatrix * atmoWP;
        #endif
        vAtmoWorldPos = (modelMatrix * atmoWP).xyz;`);   // skinning already applied to `transformed`
    shader.fragmentShader = shader.fragmentShader
      .replace("#include <common>", `#include <common>\nvarying vec3 vAtmoWorldPos;\n${atmosphereParsGLSL}`)
      .replace("#include <fog_fragment>",
        "gl_FragColor.rgb = applyAtmosphere(gl_FragColor.rgb, distance(vAtmoWorldPos, uCamPos), vAtmoWorldPos);");
  };
  mat.customProgramCacheKey = () => "atmosphere-v1";
  mat.needsUpdate = true;
}
```

This is applied once when SceneSlot loads the GLB (city meshes, target, Simon bodypart), to the ground plane in GridFloor, and to any MeshStandardMaterial we add. `scene.fog = FogExp2(fogColor, fogDensity)` stays as a **fallback** for anything left unpatched (drei helpers and so on), using the same color and density.

### 3.5 `src/shaders/hedgePillar.glsl.ts` (hero and depth layers)

- **Geometry**: `BoxGeometry(w, h, w, 24, 96, 24)`, deformed once on the CPU with a gentle twist and hourglass waist, like the reference.
- **Fragment**:
  - fBm/cellular leaf-clump AO for the hedge texture
  - half-Lambert from the rim and key lights
  - a **top-edge rim term** (`smoothstep(h-1.5, h, localY) * facing-light`) pushed above 1.0, so only the lit top edge passes the bloom threshold
  - `applyAtmosphere()` last

